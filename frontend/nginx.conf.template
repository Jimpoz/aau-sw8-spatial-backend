server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Live vision WebSocket. Must carry the Upgrade/Connection headers
    # and HTTP/1.1 or nginx silently degrades the handshake to a plain
    # GET — which the middleware then routes to its HTTP proxy and
    # ml-vision answers with 404. Longest-prefix match means this wins
    # over the generic /api/ block below for the stream path.
    location /api/v1/ml-vision/ws/ {
        proxy_pass http://middleware:8080/api/v1/ml-vision/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Api-Key ${API_SECRET};
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    location /api/ {
        proxy_pass http://middleware:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Api-Key ${API_SECRET};
        proxy_set_header X-Map-Maker 1;
        proxy_read_timeout 900s;
        client_max_body_size 200m;
    }

    location /health {
        proxy_pass http://middleware:8080/health;
    }
}
